{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajaraa",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "cc1d7bf9-39a2-45f1-a234-1fa68d754f8f" }],
  "observability": { "enabled": true }
}
